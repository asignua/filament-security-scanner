{
    "name": "asignua/filament-security-scanner",
    "description": "Detection (not protection) of intrusion traces for Filament: web shells and polyglots in uploads, drift from git and a vendor hash snapshot, obfuscated PHP, quarantine and alerts.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "security",
        "intrusion-detection",
        "webshell",
        "malware-scanner"
    ],
    "homepage": "https://github.com/asignua/filament-security-scanner",
    "support": {
        "issues": "https://github.com/asignua/filament-security-scanner/issues",
        "source": "https://github.com/asignua/filament-security-scanner"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "guzzlehttp/guzzle": "^7.8.2|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentSecurityScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentSecurityScanner\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentSecurityScanner\\SecurityScannerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "asign/eegnith-security-scanner": "*"
    },
    "suggest": {
        "spatie/laravel-medialibrary": "Checks a file synchronously the moment it is added to the media library (MediaHasBeenAddedEvent)."
    }
}
